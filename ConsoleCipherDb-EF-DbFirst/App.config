<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="crypteronCipherCore" type="Crypteron.CipherCore.ConfigFile.CrypteronCipherCoreSection, CipherCore, Version=2015, Culture=neutral, PublicKeyToken=e0287981ec67bb47" requirePermission="false" />
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>

  <crypteronCipherCore>
    <cipherDbConfig securePrefix="Secure_"
        bindRow="true"
        allowNullsInSecureFields="false"
        migrationPolicy="NoOld"
        migrationLimit="5" />
    <myCrypteronAccount appSecret="EiBylp6PdY5Xr3ZPuDQMuBnYxN2RKZdHBBG21Ly1XjH6/RiJEA==" />
  </crypteronCipherCore>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
  </startup>
  <entityFramework>
    <defaultConnectionFactory type="System.Data.Entity.Infrastructure.LocalDbConnectionFactory, EntityFramework">
      <parameters>
        <parameter value="v11.0" />
      </parameters>
    </defaultConnectionFactory>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
  <connectionStrings>
    <!--Example: Enterprise mode. Hosting the keychain storage on Azure Blob Storage -->
    <add name="StorageConnectionString" connectionString="DefaultEndpointsProtocol=https;AccountName=yourBlobStorageAccountName;AccountKey=yourBlobStoragePassword" />

    <!--Example: Local SDF file (SQL CE). You need to create the SDF file -->
    <!--<add name="PlainDbContext" connectionString="metadata=res://*/Model1.csdl|res://*/Model1.ssdl|res://*/Model1.msl;provider=System.Data.SqlServerCe.4.0;provider connection string=&quot;data source=|DataDirectory|\SQL-CE-database.sdf&quot;" providerName="System.Data.EntityClient" />-->

    <!--Example: LocalDB. Already made for you in these sample apps-->
    <add name="PlainDbContext" connectionString="metadata=res://*/Model1.csdl|res://*/Model1.ssdl|res://*/Model1.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=(localdb)\v11.0;Integrated Security=true;AttachDBFilename=|DataDirectory|CipherDbDatabaseFirst.mdf;&quot;" providerName="System.Data.EntityClient" />

    <!--Example: SQL Server. You need to replace all the [ ] tokens below -->
    <!--<add name="PlainDbContext" connectionString="metadata=res://*/Model1.csdl|res://*/Model1.ssdl|res://*/Model1.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=[serverName];initial catalog=[myDataBase];user id=[LoginForDb];password=[myPassword];MultipleActiveResultSets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient" />-->

    <!--Example: Azure SQL. You need to replace all the [ ] tokens below -->
    <!--<add name="PlainDbContext" connectionString="metadata=res://*/Model1.csdl|res://*/Model1.ssdl|res://*/Model1.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=tcp:[serverName].database.windows.net,1433;initial catalog=[myDataBase];persist security info=True;user id=[LoginForDb]@[serverName];password=[myPassword];MultipleActiveResultSets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient" />-->
  </connectionStrings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Data.OData" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-5.2.0.0" newVersion="5.2.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.WindowsAzure.Storage" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.0.0" newVersion="4.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>